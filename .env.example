# Environment Configuration Example
# Copy this file to .env and modify as needed for local development or deployment

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Service Binding
HOST=127.0.0.1
PORT=8000
STREAMLIT_PORT=8501

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=mlruns
MLFLOW_ALLOW_FILE_STORE=true

# Data Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODEL_DIR=models

# Asymmetric Cost Matrix Weights ($)
COST_FP=10
COST_FN=500
